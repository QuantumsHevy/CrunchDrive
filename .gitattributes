# Let git decide for anything not listed: text files are stored with LF in the repo.
* text=auto

# Files that use CRLF in the working folder.
*.cs      text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.slnx    text eol=crlf
*.cfg     text eol=crlf
*.version text eol=crlf

# Files that must stay LF (they run on Linux in GitHub Actions).
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# Never touch these.
*.png  binary
*.jpg  binary
*.wav  binary
*.ogg  binary
*.mu   binary
*.mm   binary
*.dll  binary
*.zip  binary